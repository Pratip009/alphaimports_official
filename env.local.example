# ── Cloudflare R2 (image storage) ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Cloudinary (only needed to run the one-time migration script) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on your Resend-verified domain (not @resend.dev),
# e.g. "Alpha Imports <orders@alphaimports.com>"
EMAIL_FROM=
# Where customers' replies and "Need help?" emails go
SUPPORT_EMAIL=support@alphaimports.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@alphaimports.com
NEXT_PUBLIC_SITE_URL=https://www.alphaimports.com

# ── Scheduled jobs (Vercel Cron sends this automatically) ────────────────────
# Needed by /api/cron/cleanup-guests and the other cron routes
CRON_SECRET=
